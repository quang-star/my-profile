# PostgreSQL
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio_secret

# Backend Admin Auth (doi truoc khi deploy production!)
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change_me_strong_password
APP_JWT_SECRET=replace-with-a-random-secret-key-at-least-32-chars-long
# Optional AES-256 key to encrypt sensitive DB settings (e.g. AI_API_KEY); falls back to APP_JWT_SECRET if omitted
APP_ENCRYPTION_KEY=

# Optional AI CV Parser Router fallback defaults (can also be configured in /admin)
AI_ENABLED=true
AI_API_BASE_URL=http://localhost:20128/v1
AI_API_KEY=
AI_MODEL=kr/claude-sonnet-4.5

# Ports & Binding
BACKEND_BIND_IP=127.0.0.1
BACKEND_PORT=8080
FRONTEND_PORT=3005

# Google OAuth2 Client ID (optional - leave empty to disable Google Sign-In)
APP_GOOGLE_CLIENT_ID=

# Public Frontend URL (used in password reset emails)
APP_FRONTEND_URL=http://localhost:3005

# SMTP Email (optional - used for Forgot Password emails; e.g. Gmail SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
APP_MAIL_FROM=

# CORS Origins (comma-separated)
APP_CORS_ORIGINS=http://localhost:3005,http://localhost:5175
